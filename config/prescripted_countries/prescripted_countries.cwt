types = {
	type[prescripted_country] = {
		path = "game/prescripted_countries"
		path_extension = .txt
		localisation = {
			name = name
			desc = "EMPIRE_DESIGN_$_desc"
		}
	}
}

prescripted_country = {
    ## cardinality = 0..1
    key = localisation
    ## cardinality = 0..1
    key = scalar

    ## cardinality = 0..1
	name = localisation
    ## cardinality = 0..1
    name = single_alias_right[complex_localisation]

    ## cardinality = 0..1
	adjective = localisation
    ## cardinality = 0..1
    adjective = single_alias_right[complex_localisation]

	## cardinality = 0..1
	spawn_enabled = bool # yes / no / always ---> this one receives always as well!
	## cardinality = 0..1
	spawn_enabled = always

	## cardinality = 0..1
	default = yes

	## cardinality = 0..1
	ignore_portrait_duplication = bool

	## cardinality = 0..1
	spawn_as_fallen = bool

    ## cardinality = 0..1
	ship_prefix = localisation
    ## cardinality = 0..1
    ship_prefix = single_alias_right[complex_localisation]

	## cardinality = 1..1
	species = single_alias_right[prescripted_country_species]

	## cardinality = 0..1
	secondary_species = single_alias_right[prescripted_country_species]

	## cardinality = 0..1
	playable = <scripted_trigger>

	room = icon[gfx/portraits/city_sets]
	room = <asset_selector.room> #this one is defined under gfx/portraits/asset_selectors

	## cardinality = 0..1
	authority = <authority>
	## cardinality = 0..1
	civics = {
   		## cardinality = 0..inf
		## cardinality_max_define = NGameplay.GOVERNMENT_CIVIC_POINTS_BASE
    	<civic_or_origin.civic>
   	}
	## cardinality = 0..1
	government = <government>

	## cardinality = 0..1
	advisor_voice_type = <advisor_voice>

	## cardinality = 0..1
	origin = <civic_or_origin.origin>

	## cardinality = 0..3
	## cardinality_max_define = NGameplay.ETHOS_MAX_POINTS
	ethic = <ethic>

  	## cardinality = 0..1
	flag = <prescripted_flags>

    ## cardinality = 0..1
	planet_name = localisation
    ## cardinality = 0..1
    planet_name = single_alias_right[complex_localisation]

	planet_class = <planet_class.habitable_planet>

	## cardinality = 0..1
	initializer = <solar_system_initializer>
	## cardinality = 0..1
	initializer = ""

    ## cardinality = 0..1
	system_name = localisation
    ## cardinality = 0..1
    system_name = single_alias_right[complex_localisation]

	graphical_culture = <graphical_culture>
	city_graphical_culture =  <graphical_culture> #obviously there is some difference with the one above, but im not sure - should check this connection.

	empire_flag = single_alias_right[empire_flag]

	ruler = {
        ## cardinality = 0..1
		name = localisation
        ## cardinality = 0..1
		name = {
            ## cardinality = 0..1
			first_name = localisation
            ## cardinality = 0..1
			second_name = localisation

            ## cardinality = 0..1
            full_names = single_alias_right[complex_localisation]

            ## cardinality = 0..1
            use_full_regnal_name = bool
		}

        ## cardinality = 0..1
		gender = enum[genders_not_set]

        ## cardinality = 0..1
		portrait = <portrait>
        ## cardinality = 0..1
		portrait = <portrait_group>

        ## cardinality = 0..1
		texture = int
		## cardinality = 0..1
		evolution_mask = int
		## cardinality = 0..1
		attachment = int
		## cardinality = 0..1
		clothes = int

        ## cardinality = 0..1
		ruler_title = localisation
		## cardinality = 0..1
        ruler_title = single_alias_right[complex_localisation]

		## cardinality = 0..1
		custom_biography = localisation

        ## cardinality = 0..1
		ruler_title_male = localisation
		## cardinality = 0..1
        ruler_title_male = single_alias_right[complex_localisation]

		## cardinality = 0..1
		ruler_title_female = localisation
		## cardinality = 0..1
        ruler_title_female = single_alias_right[complex_localisation]

		## cardinality = 0..1
		heir_title = localisation
		## cardinality = 0..1
        heir_title = single_alias_right[complex_localisation]

        ## cardinality = 0..1
		heir_title_female = localisation
		## cardinality = 0..1
        heir_title_female = single_alias_right[complex_localisation]

		## cardinality = 0..1
		leader_class = <leader_class>
		## cardinality = 0..inf
	    trait = <trait.leader_trait>
	}

	## cardinality = 0..1
	name_list = <name_list>

	## cardinality = 0..1
	species_name = localisation
	## cardinality = 0..1
	species_plural = localisation
	## cardinality = 0..1
	species_adjective = localisation
	## cardinality = 0..1
	species_class = <species_class>
	## cardinality = 0..1
	species_bio = scalar

	## cardinality = 0..1
	portrait = <portrait>
	## cardinality = 0..1
	portrait = <portrait_group>

	## cardinality = 0..inf
	trait = <trait.species_trait>

    ## cardinality = 0..1
    is_nomadic = bool
    ## cardinality = 0..1
    ship_size = <ship_size.arkship>
}

single_alias[prescripted_country_species] = {
    ## cardinality = 1..1
    class = <species_class>

    ## cardinality = 0..1
    portrait = <portrait>
    ## cardinality = 0..1
    portrait = <portrait_group>

    ## cardinality = 0..1
    name = localisation
    ## cardinality = 0..1
    species_name = localisation
    ## cardinality = 0..1
    species_name = single_alias_right[complex_localisation]

    ## cardinality = 0..1
    plural = localisation
    ## cardinality = 0..1
    species_plural = localisation
    ## cardinality = 0..1
    species_plural = single_alias_right[complex_localisation]

    ## cardinality = 0..1
    adjective = localisation
    ## cardinality = 0..1
    species_adjective = localisation
    ## cardinality = 0..1
    species_adjective = single_alias_right[complex_localisation]

    name_list = <name_list>
    ## cardinality = 0..1
    gender = enum[genders_not_set]
    ## cardinality = 0..1
    species_bio = scalar
    ## cardinality = 0..inf
    trait = <trait.species_trait>
}

single_alias[complex_localisation] = {
    ## cardinality = 0..1
    key = localisation
    ## cardinality = 0..1
    key = scalar

    ## cardinality = 0..1
    literal = bool

    ## cardinality = 0..1
    variables = {
        ## cardinality = 1..inf
        {
            ## cardinality = 0..1
            key = localisation
            ## cardinality = 0..1
            key = scalar

            value = {
                ## cardinality = 0..1
                key = localisation
                ## cardinality = 0..1
                key = scalar

                ## cardinality = 0..1
                literal = bool
            }
        }
    }
}

single_alias[empire_flag] = {
    ## cardinality = 1..1
    icon = single_alias_right[complex_file_path:flag]
    ## cardinality = 1..1
    background = single_alias_right[complex_file_path:flag]
    ## cardinality = 1..1
    colors = {
        ## cardinality = 0..4
        <color_define>
        ## cardinality = 0..4
        "null"
    }
}

single_alias[complex_file_path:flag] = {
    # TODO: two parts combined in filepath `game/flags/<category>/<file>` with related paths `game/flags/<category>/map/<file>` and `game/flags/<category>/small/<file>` if available
    category = scalar
    file = scalar
}