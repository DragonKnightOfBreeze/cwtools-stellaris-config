# Override Config (Stellaris)
#
# See `cwt/core/00_overrides.cwt` for the format, strategies, confidence labels and sources.
# Only game-specific entries are listed here; unmatched paths default to `lios`.
#
# Game-specific sources:
# - Stellaris Wiki "file overwrite list" (translated by pdxdoc / Stellaris Mod Group):
#   https://main--pdxdoc-next.netlify.app/guides/other/overwrite/
# - IronyModManager (IMM):
#   - FIOS paths: src/IronyModManager.IO/Mods/InfoProviders/StellarisDefinitionInfoProvider.cs
#   - Parser map: References/CopyAll/Maps/StellarisParserMap.json
#   - Extraction script: scripts/util/fetch_override_strategies.py
# - Official wiki: https://stellaris.paradoxwikis.com/Stellaris_Wiki
#
# Note: `lenient dupl` means the engine actually requires a whole-file override (dupl), but this
# config relaxes it to `lios` to avoid an overly strict same-path requirement. IMM whole-text and
# overwritten-object handling are implementation choices and are not necessarily the engine behavior.
#
# See: docs/en/ref-config-format.md#config-override
# Version: 3.0.4-dev
# Date: 2026-10-02

overrides = {
    # [medium] Lenient dupl: a partial override breaks auto-generated modifiers (wiki); IMM treats
    # it as an overwritten object.
    "common/buildings" = lios

    # [medium] IMM FIOSPaths.
    "common/component_sets" = fios

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/component_templates" = fios

    # [medium] Wiki: cannot be partially overridden, requires a whole-file override; IMM treats it
    # as an overwritten object (lios).
    "common/diplomatic_actions" = dupl

    # [medium] Lenient dupl: a partial override breaks auto-generated modifiers (wiki); IMM treats
    # it as an overwritten object.
    "common/districts" = lios

    # [medium] Lenient dupl: wiki says last-in override but recommends a whole-file override; IMM
    # treats it as an overwritten single-file object (dupl).
    "common/ethics" = lios

    # [high] IMM FIOSPaths; wiki: read once.
    "common/event_chains" = fios

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/global_ship_designs" = fios

    # [medium] Wiki: cannot be partially overridden, requires a whole-file override; IMM uses fios.
    "common/governments/authorities" = dupl

    # [low] IMM treats it as whole text (dupl).
    "common/name_lists" = dupl

    # [low] IMM parser map: default parser (lios); the previous `dupl` note is outdated; the wiki
    # does not specify.
    "common/observation_station_missions" = lios

    # [high] Wiki: automatically merged in load order, without overriding (IMM handles it as whole
    # text, which is an implementation shortcut).
    "common/on_actions" = ordered

    # [medium] Lenient dupl: a partial override breaks the auto-generated habitability modifiers
    # (wiki); IMM treats it as an overwritten object.
    "common/planet_classes" = lios

    # [medium] Lenient dupl: wiki says it cannot be partially overridden; IMM treats it as an
    # overwritten object.
    "common/pop_jobs" = lios

    # [low] Wiki: cannot be overridden (approximated as fios); IMM treats it as an overwritten
    # object (lios).
    "common/relics" = fios

    # [medium] Existing convention; IMM parser map: generic key parser (lios).
    "common/scripted_loc" = fios

    # [high] IMM FIOSPaths; wiki: read once.
    "common/scripted_variables" = fios

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/section_templates" = fios

    # [medium] IMM FIOSPaths.
    "common/ship_behaviors" = fios

    # [medium] IMM: overwritten single-file object; wiki: cannot be partially overridden, requires
    # a whole-file override.
    "common/ship_sizes" = dupl

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/solar_system_initializers" = fios

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/special_projects" = fios

    # [medium] Lenient dupl: a partial override breaks auto-generated modifiers (wiki); IMM treats
    # it as an overwritten object.
    "common/species_archetypes" = lios

    # [high] Wiki: read once (IMM parser map uses the default parser, an IMM limitation).
    "common/star_classes" = fios

    # [medium] IMM: overwritten single-file object; wiki: cannot be partially overridden, requires
    # a whole-file override.
    "common/starbase_modules" = dupl

    # [medium] IMM FIOSPaths; wiki: read once.
    "common/start_screen_messages" = fios

    # [high] Wiki: read once (IMM parser map uses the default parser, an IMM limitation).
    "common/static_modifiers" = fios

    # [medium] IMM FIOSPaths + overwritten single-file object; wiki: read once.
    "common/strategic_resources" = fios

    # [medium] Wiki: cannot be partially overridden, requires copying the whole file (IMM treats it
    # as an overwritten object).
    "common/technology" = dupl

    # [medium] IMM parser map: default parser (lios).
    "common/technology/category" = lios

    # [medium] IMM parser map: default parser (lios).
    "common/technology/tier" = lios

    # [medium] Wiki: entries may duplicate and cannot be partially overridden, requires a whole-file
    # override (IMM uses fios).
    "common/traits" = dupl

    # [high] IMM FIOSPaths; wiki: read once.
    "events" = fios
}
