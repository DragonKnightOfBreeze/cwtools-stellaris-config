types = {
	type[galaxy_shape] = {
		path = "game/map/galaxy"
		path_extension = .txt
		localisation = {
			name = $
		}
		images = {
			## primary
			icon = button_icon
		}
	}
	## type_key_filter = setup_scenario
	type[setup_scenario] = {
		path = "game/map/setup_scenarios"
		name_field = name
		path_extension = .txt
		localisation = {
			name = $
		}
	}
	## type_key_filter = static_galaxy_scenario
	type[static_galaxy_scenario] = {
		path = "game/map/setup_scenarios"
		name_field = name
		path_extension = .txt
		localisation = {
			name = $
		}
	}
}

galaxy_shape = {
	### Core radius is x% of the galaxy radius
	## cardinality = 0..1
	core_radius_perc = float
	### Number of stars in core
	## cardinality = 0..1
	num_stars_core_perc = float
	### Min distance between stars
	## cardinality = 0..1
	stars_min_dist = float

	## cardinality = 0..1
	countries = {
		### int*int Ideal square distance between countries
		ideal_sq_dist_between = int
		### int*int Min square distance between countries
		min_sq_dist_between = int
	}

	## cardinality = 0..1
	fallen_empires = {
		### int*int Ideal square distance between countries
		ideal_sq_dist_between = int
		### int*int Min square distance between countries
		min_sq_dist_between = int
	}

	## cardinality = 0..1
	num_arms = int

	## cardinality = 0..1
	ring = {
		### Percentage of radius to use as the width of the ring
		width = float
		### Percentage of radius to use as the offset from center for the ring
		offset = float
	}

	## cardinality = 0..1
	arms = {
		### Tightness of winding
		tightness_winding = float
		### Arm width in degrees
		width = float
		### Maximum outliers distance from arms
		fuzz = float
		### Separation (in degrees) between each arm
		seperation = float
	}

	## cardinality = 1..1
	preview_icon = <sprite>

	## cardinality = 1..1
	button_icon = <sprite>

	## cardinality = 0..1
	desc = localisation
}

scenario_base = {
	## cardinality = 1..1
	name = localisation

	### priority decides in which order the scenarios are listed
	## cardinality = 0..1
	priority = int

	## cardinality = 0..1
	default = bool

	## cardinality = 0..1
	num_empires = {
		## cardinality = 0..1
		min = int
		## cardinality = 0..1
		max = int
	}
    ## cardinality = 0..1
	num_empire_default = int

    ## cardinality = 0..1
	fallen_empire_default = int
    ## cardinality = 0..1
	fallen_empire_max = int

    ## cardinality = 0..1
	marauder_empire_default = int
    ## cardinality = 0..1
    ## cardinality = 0..1
	marauder_empire_max = int

    ## cardinality = 0..1
	nomad_empire_default = int
    ## cardinality = 0..1
	nomad_empire_max = int

    ## cardinality = 0..1
	advanced_empire_default = int

    ## cardinality = 0..1
	colonizable_planet_odds = float

    ## cardinality = 0..1
	primitive_odds = float

    ## cardinality = 0..1
	crisis_strength = float
	## cardinality = 0..1
	extra_crisis_strength = {
		## cardinality = 0..inf
		float
	}
}

## inject = map/map.cwt@scenario_base/*
setup_scenario = {
    ## cardinality = 0..1
	num_stars = int

	### should be less than 500, preferably less than ~460
    ## cardinality = 0..1
	radius = float

    ## cardinality = 0..1
	cluster_count = {
		method = enum[cluster_method]
		value = int
		max = int
	}
    ## cardinality = 0..1
	cluster_radius = float
    ## cardinality = 0..1
	cluster_distance_from_core = float

    ## cardinality = 0..1
	max_hyperlane_distance = float

    ## cardinality = 0..1
	home_system_partitions = {
        ## cardinality = 0..1
		max_systems = int
        ## cardinality = 0..1
		min_systems = int

        ## cardinality = 0..1
		min_bridges = int
        ## cardinality = 0..1
		max_bridges = int

        ## cardinality = 0..1
		method = enum[home_system_method]
	}

    ## cardinality = 0..1
	open_space_partitions = {
        ## cardinality = 0..1
		max_systems = int
        ## cardinality = 0..1
		min_systems= int

        ## cardinality = 0..1
		min_bridges = int
        ## cardinality = 0..1
		max_bridges = int

        ## cardinality = 0..1
		method = enum[open_space_method]
	}

    ## cardinality = 0..1
	num_nebulas	= int
    ## cardinality = 0..1
	nebula_size = float
    ## cardinality = 0..1
	nebula_min_dist = float

    ## cardinality = 0..1
	num_wormhole_pairs = {
        ## cardinality = 0..1
		min = float
        ## cardinality = 0..1
		max = float
	}
    ## cardinality = 0..1
	num_wormhole_pairs_default = float

    ## cardinality = 0..1
	num_gateways = {
        ## cardinality = 0..1
		min = float
        ## cardinality = 0..1
		max = float
	}
    ## cardinality = 0..1
	num_gateways_default = float

    ## cardinality = 0..1
	num_hyperlanes = {
        ## cardinality = 0..1
		min = float
        ## cardinality = 0..1
		max = float
	}
    ## cardinality = 0..1
	num_hyperlanes_default = float

	## cardinality = 1..inf
	supports_shape = <galaxy_shape>
}

## inject = map/map.cwt@scenario_base/*
static_galaxy_scenario = {
	## cardinality = 0..1
	random_hyperlanes = bool
	## cardinality = 0..1
	core_radius = int
	### Subsequent systems will have the coordinates entered for them altered by these numbers
	## cardinality = 0..1
	coordinate_transform = {
		## cardinality = 0..1
		x = single_alias_right[coordinate_transform]
		## cardinality = 0..1
		y = single_alias_right[coordinate_transform]
		## cardinality = 0..1
		z = single_alias_right[coordinate_transform]
	}
	## cardinality = 0..inf
	system = {
		## cardinality = 0..1
		id = enum[map_setup_scenario_system_id]
        ## cardinality = 0..1
		name = localisation
        ## cardinality = 1..1
		position = {
            ## cardinality = 0..1
			x = float
            ## cardinality = 0..1
			x = {
                ## cardinality = 0..1
                min = float
                ## cardinality = 0..1
                max = float
            }

            ## cardinality = 0..1
			y = float
            ## cardinality = 0..1
			y = {
                ## cardinality = 0..1
                min = float
                ## cardinality = 0..1
                max = float
            }
		}
		## cardinality = 0..1
		initializer = <solar_system_initializer>
		## cardinality = 0..1
		## replace_scopes = { this = country root = country }
		spawn_weight = {
            ## cardinality = 0..inf
			alias_name[modifier_rule] = alias_match_left[modifier_rule]
		}
		## cardinality = 0..1
		spawn_design = <prescripted_country>
		## cardinality = 0..1
		## replace_scopes = { this = system root = system }
		effect = single_alias_right[effect_clause]
	}
	## cardinality = 0..inf
	add_hyperlane = {
        ## cardinality = 1..1
		from = enum[map_setup_scenario_system_id]
        ## cardinality = 1..1
		to = enum[map_setup_scenario_system_id]
	}
	## cardinality = 0..inf
	prevent_hyperlane = {
        ## cardinality = 1..1
		from = enum[map_setup_scenario_system_id]
        ## cardinality = 1..1
		to = enum[map_setup_scenario_system_id]
	}
	## cardinality = 0..inf
	nebula = {
        ## cardinality = 0..1
		name = scalar
        ## cardinality = 0..1
		name = localisation
        ## cardinality = 0..1
		position = {
            ## cardinality = 1..1
			x = int
            ## cardinality = 1..1
			y = int
            ## cardinality = 1..1
			z = int
		}
        ## cardinality = 0..1
		radius = int
	}
}

single_alias[coordinate_transform] = {
	## cardinality = 0..inf
	enum[coordinate_transform_operator] = float
}

enums = {
	enum[cluster_method] = {
		one_every_x_empire
		constant
	}
	enum[home_system_method] = {
		breadth_first
	}
	enum[open_space_method] = {
		depth_first
	}
	enum[coordinate_transform_operator] = {
		add
		sub
		mul
		div
	}
}

enums = {
	## per_definition
	complex_enum[map_setup_scenario_system_id] = {
		path = "game/map/setup_scenarios"
		path_extension = .txt
		per_definition = yes
		start_from_root = yes
		name = {
			static_galaxy_scenario = {
				system = {
					id = enum_name
				}
			}
		}
	}
}
