alias[name:name] = localisation
alias[name:name] = scalar
alias[name:name] = {
	key = localisation
	## cardinality = 0..inf
	variable_string = scalar
}

### Applies the value of the static modifier X right hand side factor
alias[modifier:<static_modifier>] = float
### Applies the value of a scripted modifier from common/scripted_modifiers
alias[modifier:<scripted_modifier>] = float
### Applies the value of a modifier
alias[modifier:<modifier>] = float

# modifier

single_alias[modifier_clause] = {
	alias_name[modifier] = alias_match_left[modifier]

	## cardinality = 0..1
	description = localisation
	## cardinality = 0..1
	description_parameters = {
		### Any value can go here to be used in localisation
		## cardinality = 0..inf
		$localisation_parameter = scalar
	}
	#### Default: yes
	## cardinality = 0..1
	show_only_custom_tooltip = bool
	## cardinality = 0..1
	custom_tooltip = localisation
}

# triggered modifier

triggered_modifier_clause_base = {
    ## cardinality = 0..1
	key = localisation

	### default: no
	## cardinality = 0..1
	show_if_not_potential = bool
	## cardinality = 0..1
	not_potential_override_text_key = localisation

	## cardinality = 0..1
	modifier = single_alias_right[modifier_clause]
	## cardinality = 0..inf
	alias_name[modifier] = alias_match_left[modifier]

	## cardinality = 0..1
	description = localisation
	## cardinality = 0..1
	description_parameters = {
		### Any value can go here to be used in localisation
		## cardinality = 0..inf
		$localisation_parameter = scalar
	}
	## cardinality = 0..1
	show_only_custom_tooltip = bool
	## cardinality = 0..1
	custom_tooltip = localisation

	## cardinality = 0..inf
	mult = value_field
	## cardinality = 0..inf
	multiplier = value_field

	### default no
	## cardinality = 0..1
	show_potential_if_true = bool
	### default yes
	## cardinality = 0..1
	should_mult_desc = bool
	## cardinality = 0..1
	fix_key = localisation
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_clause] = {
	## cardinality = 0..1
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_pop_group_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = pop_group root = pop_group }
	potential = single_alias_right[trigger_clause]

    ### default: yes?
	## cardinality = 0..1
	divide_over_pop_groups = bool
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_planet_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = planet root = planet }
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_colony_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = colony root = colony }
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_starbase_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = starbase root = starbase }
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_situation_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = situation root = situation }
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_leader_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = leader root = leader }
	potential = single_alias_right[trigger_clause]

	### If "possible" is true, the "possible" description and the "modifier" will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_true = bool

	### Localization shown instead of the "possible" description when the "possible" is true (will enable "show_trigger_if_true")
	## cardinality = 0..1
	trigger_true_key_override = localisation

	### If "potential" is false, every modifier will still be shown in the tooltip
	## cardinality = 0..1
	show_if_trigger_false = bool

	### If "potential" is false, the "potential" description will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_false = bool

	### Localization shown instead of the "possible" description when the "possible" is false (will enable "show_trigger_if_false")
	## cardinality = 0..1
	trigger_false_key_override = localisation
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_by_megastructure_clause] = {
	## cardinality = 0..1
	## replace_scopes = { this = megastructure root = megastructure }
	potential = single_alias_right[trigger_clause]
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_for_trigger_details] = {
	## cardinality = 0..1
	potential = single_alias_right[trigger_clause]

	### If "possible" is true, the "possible" description and the "modifier" will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_true = bool

	### Localization shown instead of the "possible" description when the "possible" is true (will enable "show_trigger_if_true")
	## cardinality = 0..1
	trigger_true_key_override = localisation

	### If "potential" is false, every modifier will still be shown in the tooltip
	## cardinality = 0..1
	show_if_trigger_false = bool

	### If "potential" is false, the "potential" description will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_false = bool

	### Localization shown instead of the "possible" description when the "possible" is false (will enable "show_trigger_if_false")
	## cardinality = 0..1
	trigger_false_key_override = localisation
}

## inject = aliases.cwt@triggered_modifier_clause_base/*
single_alias[triggered_modifier_for_tenet] = {
	## cardinality = 0..1
	potential = single_alias_right[trigger_clause]

	## cardinality = 0..1
	possible = single_alias_right[trigger_clause]

	### If "possible" is true, the "possible" description and the "modifier" will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_true = bool

	### Localization shown instead of the "possible" description when the "possible" is true (will enable "show_trigger_if_true")
	## cardinality = 0..1
	trigger_true_key_override = localisation

	### If "potential" is false, every modifier will still be shown in the tooltip
	## cardinality = 0..1
	show_if_trigger_false = bool

	### If "potential" is false, the "potential" description will be shown in the tooltip
	## cardinality = 0..1
	show_trigger_if_false = bool

	### Localization shown instead of the "possible" description when the "possible" is false (will enable "show_trigger_if_false")
	## cardinality = 0..1
	trigger_false_key_override = localisation
}

# triggered desc

single_alias[triggered_desc_clause] = {
	## cardinality = 0..1
	trigger = single_alias_right[trigger_clause]
	# can be declared in trigger = {...}
	## cardinality = 0..1
	text = localisation
}

# trigger

single_alias[trigger_clause] = {
	alias_name[trigger] = alias_match_left[trigger]
}

# effect

single_alias[effect_clause] = {
	alias_name[effect] = alias_match_left[effect]
}

# others

single_alias[leader_traits] = {
	## cardinality = 0..inf
	int = <trait.leader_trait>
	## cardinality = 0..inf
	int = random_trait
	## cardinality = 0..inf
	int = random_common
	## cardinality = 0..inf
	trait = <trait.leader_trait>
	## cardinality = 0..inf
	trait = random_trait
	## cardinality = 0..inf
	trait = random_common
}

# no `AND = {...}` usages in vanilla files atm (game version 4.5), so following should be enough
single_alias[technology_prerequisites] = {
    ## cardinality = 0..inf
    <technology>
    ## cardinality = 0..inf
    OR = {
        ## cardinality = 0..inf
        <technology>
    }
}
